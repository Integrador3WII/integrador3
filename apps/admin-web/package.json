{
  "name": "@textilflow/admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:db": "node --test ../../supabase/tests/catalog-inventory.test.mjs ../../supabase/tests/admin-order-metrics.test.mjs ../../supabase/tests/order-quote-workflows.test.mjs",
